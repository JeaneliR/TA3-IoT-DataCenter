{
  "version": 1,
  "author": "Jeaneli Rosmery Caso Valenzuela",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 10,
      "left": 10,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -30,
      "left": 300,
      "attrs": {
        "temperature": "26.5",
        "humidity": "55"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 180,
      "left": 290,
      "attrs": {
        "lux": "500"
      }
    }
  ],
  "connections": [
  ["esp:TX", "$serialMonitor:RX", "", []],
  ["esp:RX", "$serialMonitor:TX", "", []],
  ["esp:3V3", "dht1:VCC", "red", []],
  ["esp:GND.1", "dht1:GND", "black", []],
  ["esp:15", "dht1:SDA", "green", []],
  ["esp:3V3", "ldr1:VCC", "red", []],
  ["esp:GND.1", "ldr1:GND", "black", []],
  ["esp:34", "ldr1:AO", "blue", []]
  ],

  "dependencies": {},
  "serialMonitor": {
    "display": "terminal",
    "newline": "lf"
  }
}