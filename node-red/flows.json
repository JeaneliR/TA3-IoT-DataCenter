    {
        "id": "41fabe01d53a2264",
        "type": "function",
        "z": "267b1061c51745a8",
        "name": "Validar y clasificar",
        "func": "const datos = msg.payload;\n\nif (typeof datos !== \"object\" || datos === null) {\n    node.warn(\"Mensaje inválido: se esperaba un objeto JSON\", msg);\n    return null;\n}\n\nconst valorTemperatura =\n    datos.temperatura !== undefined\n        ? datos.temperatura\n        : datos.valor;\n\nconst temperatura = Number(valorTemperatura);\nconst iluminacion = Number(datos.iluminacion);\n\nif (!Number.isFinite(temperatura)) {\n    node.warn(\"Lectura de temperatura inválida\", msg);\n    return null;\n}\n\nlet estadoTemperatura;\n\nif (temperatura < 28) {\n    estadoTemperatura = \"normal\";\n} else if (temperatura < 30) {\n    estadoTemperatura = \"advertencia\";\n} else {\n    estadoTemperatura = \"critica\";\n}\n\nmsg.payload = {\n    dispositivo: String(\n        datos.dispositivo || \"esp32-sala1\"\n    ),\n    temperatura: temperatura,\n    iluminacion: Number.isFinite(iluminacion)\n        ? iluminacion\n        : null,\n    estado_temperatura: estadoTemperatura,\n    fecha_hora: new Date().toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 220,
