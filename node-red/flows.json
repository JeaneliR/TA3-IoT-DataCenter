    {
        "id": "950f33f8b508b43e",
        "type": "function",
        "z": "267b1061c51745a8",
        "name": "Preparar para InfluxDB",
        "func": "const datos = msg.payload;\n\nconst campos = {\n    temperatura: Number(datos.temperatura)\n};\n\nconst iluminacion = Number(datos.iluminacion);\n\nif (Number.isFinite(iluminacion)) {\n    campos.iluminacion = iluminacion;\n}\n\nconst etiquetas = {\n    dispositivo: String(datos.dispositivo || \"esp32-sala1\"),\n    estado: String(datos.estado_temperatura || \"desconocido\")\n};\n\nmsg.payload = [campos, etiquetas];\n\nreturn msg;",
